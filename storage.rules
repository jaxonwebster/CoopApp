rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function myProfile() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function sameHousehold(householdId) { return signedIn() && myProfile().householdId == householdId; }
    match /profiles/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /proofs/{householdId}/{userId}/{fileName} {
      allow read: if sameHousehold(householdId);
      allow write: if signedIn() && request.auth.uid == userId && sameHousehold(householdId) && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
