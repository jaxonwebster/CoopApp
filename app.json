{
  "expo": {
    "name": "Coop",
    "slug": "coop-family-chores",
    "version": "1.1.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "coopchores",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F7E7"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Coop uses your photos so you can submit proof that a chore is complete.",
          "cameraPermission": "Coop uses your camera so you can submit proof that a chore is complete."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Coop uses your location to show local weather for outdoor chores."
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "95e4b9b9-c287-4d55-af19-95315b2cfa03"
      }
    }
  }
}
